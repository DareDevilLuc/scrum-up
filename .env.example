# Supabase project URL (from Supabase dashboard > Settings > API)
VITE_SUPABASE_URL=

# Supabase anon/public key (from Supabase dashboard > Settings > API)
VITE_SUPABASE_ANON_KEY=

# OpenAI API key — NOTE: this is used only in Supabase Edge Functions (server-side).
# Do NOT expose this key in the frontend. Add it as a Supabase Edge Function secret instead.
# VITE_OPENAI_API_KEY is intentionally omitted to prevent accidental client-side exposure.
# Set OPENAI_API_KEY via: supabase secrets set OPENAI_API_KEY=sk-...
